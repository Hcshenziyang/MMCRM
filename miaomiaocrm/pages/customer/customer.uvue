<template>
  <layout>
    <view class="customer-container">
      <!-- 顶部操作栏 -->
      <view class="header-actions">
        <view class="search-container">
          <input class="search-input" v-model="searchQuery" placeholder="搜索客户名称或电话" @confirm="onSearch" />
          <button class="search-btn" @click="onSearch">🔍</button>
          <button class="add-btn" @click="openCustomerForm('create')">新增客户</button>
        </view>
      </view>

      <!-- 客户表格 -->
      <uni-table :loading="loading" border stripe emptyText="暂无客户数据">
        <uni-tr>
          <uni-th align="center" class="sortable-th" @click="handleSort('name')">
            客户名称
            <text v-if="sortColumn === 'name'" class="sort-icon">{{ sortOrder === 'asc' ? '▲' : '▼' }}</text>
          </uni-th>
          <uni-th align="center" class="sortable-th" @click="handleSort('phone')">
            电话
            <text v-if="sortColumn === 'phone'" class="sort-icon">{{ sortOrder === 'asc' ? '▲' : '▼' }}</text>
          </uni-th>
          <uni-th align="center">邮箱</uni-th>
          <uni-th align="center">地址</uni-th>
          <uni-th align="center" width="150">操作</uni-th>
        </uni-tr>
        <uni-tr v-for="item in customerList" :key="item.id">
          <uni-td align="center">{{ item.name }}</uni-td>
          <uni-td align="center">{{ item.phone }}</uni-td>
          <uni-td align="center">{{ item.email }}</uni-td>
          <uni-td align="center">{{ item.address }}</uni-td>
          <uni-td align="center">
            <button class="action-btn edit-btn" size="mini" @click="openCustomerForm('edit', item)">编辑</button>
            <button class="action-btn delete-btn" size="mini" @click="deleteCustomer(item.id)">删除</button>
          </uni-td>
        </uni-tr>
      </uni-table>

      <!-- 分页组件 -->
      <uni-pagination
        :current="page"
        :total="total"
        :pageSize="pageSize"
        @change="onPageChange"
      />

      <!-- 新增/编辑弹窗 -->
      <uni-popup ref="customerPopup" type="center" :mask-click="false">
        <view class="popup-content">
          <view class="popup-title">{{ formMode === 'create' ? '新增客户' : '编辑客户' }}</view>
          <form @submit="submitCustomerForm">
            <view class="form-item">
              <text class="label">客户名称:</text>
              <input class="input" v-model="formData.name" placeholder="请输入客户名称" required />
            </view>
            <view class="form-item">
              <text class="label">电话:</text>
              <input class="input" v-model="formData.phone" placeholder="请输入电话" required />
            </view>
            <view class="form-item">
              <text class="label">邮箱:</text>
              <input class="input" type="email" v-model="formData.email" placeholder="请输入邮箱" />
            </view>
            <view class="form-item">
              <text class="label">地址:</text>
              <input class="input" v-model="formData.address" placeholder="请输入地址" />
            </view>
            <view class="popup-actions">
              <button class="cancel-btn" @click="closeCustomerPopup">取消</button>
              <button class="submit-btn" form-type="submit" :loading="submitLoading">提交</button>
            </view>
          </form>
        </view>
      </uni-popup>
    </view>
  </layout>
</template>

<script>
// 基础和第三方组件导入
import Layout from '../layout/layout.uvue';
import UniTable from '../../uni_modules/uni-table/components/uni-table/uni-table.vue';
import UniTr from '../../uni_modules/uni-table/components/uni-tr/uni-tr.vue';
import UniTh from '../../uni_modules/uni-table/components/uni-th/uni-th.vue';
import UniTd from '../../uni_modules/uni-table/components/uni-td/uni-td.vue';
import UniPopup from '../../uni_modules/uni-popup/components/uni-popup/uni-popup.vue';
import UniPagination from '../../uni_modules/uni-pagination/components/uni-pagination/uni-pagination.vue';
import request from '../../common/request.js';  // 假设这是你的API请求工具

export default {
  components: {
    Layout,
    UniTable,
    UniTr,
    UniTh,
    UniTd,
    UniPopup,
    UniPagination,
  },
  data() {
    return {
      customerList: [],
      loading: false,
      submitLoading: false,
      formMode: 'create',
      formData: {
        id: null,
        name: '',
        phone: '',
        email: '',
        address: '',
      },
      searchQuery: '',
      sortColumn: '',
      sortOrder: 'asc',
      page: 1,
      pageSize: 10,
      total: 0,
    };
  },
  onLoad() {
    this.fetchCustomers();
  },
  methods: {
    async fetchCustomers() {
      this.loading = true;
      try {
        const params = {
          page: this.page,
          page_size: this.pageSize,
        };
        if (this.searchQuery) {
          params.search = this.searchQuery;
        }
        if (this.sortColumn) {
          const prefix = this.sortOrder === 'desc' ? '-' : '';
          params.ordering = prefix + this.sortColumn;
        }
        const res = await request('/customer/customers/', 'GET', params);
        this.customerList = Array.isArray(res) ? res : (res.results || res.data || []);
        this.total = Array.isArray(res) ? res.length : (res.count || 0);
      } catch (e) {
        console.error('获取客户列表失败:', e);
        uni.showToast({ title: '获取客户列表失败', icon: 'error' });
      } finally {
        this.loading = false;
      }
    },
    onSearch() {
      this.page = 1;
      this.fetchCustomers();
    },
    handleSort(column) {
      if (this.sortColumn === column) {
        this.sortOrder = this.sortOrder === 'asc' ? 'desc' : 'asc';
      } else {
        this.sortColumn = column;
        this.sortOrder = 'asc';
      }
      this.page = 1;
      this.fetchCustomers();
    },
    onPageChange(e) {
      this.page = e.current;
      this.fetchCustomers();
    },
    openCustomerForm(mode, customer = null) {
      this.formMode = mode;
      this.resetFormData();
      if (mode === 'edit' && customer) {
        this.formData = { ...customer };
      }
      this.$refs.customerPopup.open('center');
    },
    closeCustomerPopup() {
      this.$refs.customerPopup.close();
      this.resetFormData();
    },
    resetFormData() {
      this.formData = {
        id: null,
        name: '',
        phone: '',
        email: '',
        address: '',
      };
    },
    async submitCustomerForm() {
      if (this.submitLoading) return;
      this.submitLoading = true;
      try {
        const payload = { ...this.formData };
        if (this.formMode === 'create') {
          await request('/customer/customers/', 'POST', payload);
          uni.showToast({ title: '客户创建成功', icon: 'success' });
        } else {
          await request(`/customer/customers/${payload.id}/`, 'PATCH', payload);
          uni.showToast({ title: '客户更新成功', icon: 'success' });
        }
        this.closeCustomerPopup();
        this.fetchCustomers();
      } catch (e) {
        console.error('提交客户表单失败:', e);
        uni.showToast({ title: `操作失败: ${e.data ? JSON.stringify(e.data) : e.message}`, icon: 'error' });
      } finally {
        this.submitLoading = false;
      }
    },
    deleteCustomer(id) {
      uni.showModal({
        title: '提示',
        content: '确定要删除此客户吗？',
        success: async (res) => {
          if (res.confirm) {
            try {
              await request(`/customer/customers/${id}/`, 'DELETE');
              uni.showToast({ title: '客户删除成功', icon: 'success' });
              if (this.customerList.length === 1 && this.page > 1) {
                this.page--;
              }
              this.fetchCustomers();
            } catch (e) {
              uni.showToast({ title: '删除客户失败', icon: 'error' });
            }
          }
        }
      });
    },
  },
};
</script>

<style scoped>
/* 页面容器 */
.customer-container {
  padding: 20px;
  background-color: #fffaf6;
  min-height: 100vh;
}

/* 操作栏 */
.header-actions {
  margin-bottom: 20px;
}

/* 搜索容器 */
.search-container {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 10px;
}
.search-input {
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  padding: 7px 12px;
  font-size: 14px;
  min-height: 35px;
  box-sizing: border-box;
}
.search-btn {
  background-color: #3182ce;
  color: white;
  border-radius: 4px;
  padding: 0px 10px;
  font-size: 14px;
  border: none;
  margin: 0;
}
.search-btn::after {
  border: none;
}

/* 通用按钮 */
.add-btn,
.action-btn {
  color: white;
  border-radius: 4px;
  padding: 0px 10px;
  font-size: 14px;
  border: none;
  margin: 0;
}
.add-btn::after,
.action-btn::after {
  border: none;
}
.add-btn {
  background-color: #fea17a;
}

/* 表格内操作按钮 */
.action-btn {
  margin: 0 5px;
  padding: 4px 8px;
  font-size: 12px;
}
.edit-btn {
  background-color: #3182ce;
}
.delete-btn {
  background-color: #e53e3e;
}

/* 排序样式 */
.sortable-th {
  cursor: pointer;
  user-select: none;
}
.sortable-th:hover {
  background-color: #f8f8f8;
}
.sort-icon {
  font-size: 12px;
  margin-left: 5px;
  color: #555;
}

/* 弹窗样式 */
.popup-content {

  width: 1100rpx;
  max-width: 450px;
  background-color: #fff;
  border-radius: 10px;
  padding: 25px;
  box-sizing: border-box;
}

.popup-title {
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 25px;
  color: #333;
}

/* 表单项 */
.form-item {
  flex-direction: row; /* 明确主轴方向为水平 */
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}
.form-item .label {
  width: 100px;
  flex-shrink: 0;
  font-size: 15px;
  color: #555;
  text-align: left;
  margin-right: 15px;
}
.form-item .input {
  flex: 1;
  border: 1px solid #e0e0e0;
  border-radius: 5px;
  padding: 8px 12px;
  font-size: 14px;
  color: #333;
  min-height: 32px;
  box-sizing: border-box;
}
.form-item .input:focus {
  border-color: #fea17a;
  box-shadow: 0 0 0 1px rgba(254, 161, 122, 0.5);
}

/* 弹窗操作按钮 */
.popup-actions {
  display: flex;
  justify-content: center;
  margin-top: 30px;
  gap: 20px;
}
.cancel-btn,
.submit-btn {
  padding: 8px 25px;
  border-radius: 5px;
  font-size: 15px;
  border: none;
}
.cancel-btn::after,
.submit-btn::after {
  border: none;
}
.cancel-btn {
  background-color: #f0f0f0;
  color: #666;
  border: 1px solid #e0e0e0;
}
.submit-btn {
  background-color: #fea17a;
  color: white;
}
</style>
