<template>
  <layout>
    <view class="home-container">
      <view class="card" v-for="item in cards" :key="item.path" @click="go(item.path)">
        <image :src="item.icon" class="card-icon" />
        <text class="card-title">{{ item.name }}</text>
      </view>
    </view>
  </layout>
</template>

<script>
import Layout from '../layout/layout.uvue'
export default {
  components: { Layout },
  data() {
    return {
      cards: [
        { name: '客户管理', path: '/pages/customer/customer', icon: '/static/customer.png' },
        { name: '项目管理', path: '/pages/project/project', icon: '/static/project.png' },
        { name: '权限管理', path: '/pages/permission/permission', icon: '/static/permission.png' }
      ]
    }
  },
  methods: {
    go(path) {
      uni.navigateTo({ url: path })
    }
  }
}
</script>

