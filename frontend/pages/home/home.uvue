        :key="item.name" 
        @click="showIntro(item)"
      >
        <text class="card-title">{{ item.name }}</text>
      </view>
    </view>

    <!-- 模块介绍弹窗 -->
    <view v-if="activeModule" class="modal-mask" @click.self="closeIntro">
      <view class="modal-box">
        <text class="modal-title">{{ activeModule.name }}</text>
        <text class="modal-content">{{ activeModule.intro }}</text>
        <view class="modal-footer">
          <button class="close-btn" @click="closeIntro">关闭</button>
        </view>
      </view>
    </view>
  </layout>
</template>

<script>
import Layout from '../layout/layout.uvue'
export default {
  components: { Layout },
  data() {
    return {
      activeModule: null,
      cards: [
        { 
          name: '登录与权限控制', 
          intro:'(1) 系统采用JWT鉴权机制，实现安全、统一的用户身份验证。\n'+
		  '(2) 结合Django原生权限体系与自定义RBAC模型，支持多角色分级管理。\n'+
		  '(3) 不同角色在前端仅展示自身可访问的数据，实现用户级数据隔离。'
        },
		{
		  name: '客户管理', 
		  intro:'(1) 支持客户信息的增删改查、搜索排序。\n'+
		  '(2) 每个用户仅能查看和管理自己的客户数据。\n'+
		  '(3) 客户信息与项目模块双向关联，形成客户→项目→行动记录的业务闭环。'
		},
        { 
          name: '项目管理', 
		  intro:'(1) 用于项目全生命周期管理，支持立项、进度更新、行动记录及客户关联。\n'+
		  '(2) 项目权限与客户绑定，确保不同用户仅能操作授权范围内的项目数据。'
        },
        { 
          name: '系统性能与部署', 
		  intro:'(1) 系统通过Redis实现高频数据缓存与动态失效机制。\n'+
		  '(2) 结合Django信号系统与缓存版本控制，保证数据一致性与性能优化。\n'+
		  '(3) 全系统基于Docker容器化部署，可快速复现环境并支持多端并行开发。'
        },
		{
		  name: 'AI智能助手', 
		  intro:'(1) 基于大模型能力的对话助手，支持客户沟通话术生成、问题解答与信息整理。\n'+
		'(2) 可结合当前业务场景，对客户信息、项目进展等内容进行总结与提炼，辅助决策。\n'+
		'(3) 后端通过Dify平台接入大模型服务，实现统一调用与扩展，支持多场景灵活应用。'
		}
      ]
    }
  },
  methods: {
    showIntro(item) {
      this.activeModule = item
    },
    closeIntro() {
      this.activeModule = null
    }
  }
}
</script>

