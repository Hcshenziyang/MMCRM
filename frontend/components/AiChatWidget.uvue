<template>
  <view class="ai-root">
    <!-- 悬浮按钮 -->
    <view v-if="!open" class="ai-fab" @click="toggleOpen">
      <text class="ai-fab-text">AI</text>
    </view>

    <!-- 遮罩 + 弹窗 -->
    <view v-if="open" class="ai-mask" @click.self="close">
      <view class="ai-panel">
        <view class="ai-header">
          <text class="ai-title">AI 助手</text>
          <view class="ai-header-actions">
            <button class="ai-mini-btn" @click="clearChat">清空</button>
            <button class="ai-mini-btn" @click="close">关闭</button>
          </view>
        </view>

        <scroll-view class="ai-body" scroll-y :scroll-top="scrollTop">
          <view v-if="messages.length === 0" class="ai-empty">
            <text class="ai-empty-text">你好，我可以帮你查资料、写总结、生成客户沟通话术等。</text>
          </view>

          <view v-for="(m, idx) in messages" :key="idx" class="ai-msg-row" :class="m.role === 'user' ? 'is-user' : 'is-ai'">
            <view class="ai-bubble">
              <text class="ai-msg-text">{{ m.content }}</text>
            </view>
          </view>

          <view v-if="sending" class="ai-msg-row is-ai">
            <view class="ai-bubble">
              <text class="ai-msg-text">正在思考…</text>
            </view>
          </view>
        </scroll-view>

        <view class="ai-footer">
          <input
            class="ai-input"
            v-model="draft"
            placeholder="输入问题，回车发送"
            confirm-type="send"
            @confirm="send"
          />
          <button class="ai-send" :disabled="sending || !draft.trim()" @click="send">发送</button>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
import { aiChat } from '../common/api.js'

export default {
  name: 'AiChatWidget',
  data() {
    return {
      open: false,
      draft: '',
      sending: false,
      conversationId: null,
      messages: [],
      scrollTop: 0,
    }
  },
  methods: {
    toggleOpen() {
      this.open = !this.open
      if (this.open) this.bumpScroll()
    },
    close() {
      this.open = false
    },
    clearChat() {
      this.messages = []
      this.conversationId = null
      this.draft = ''
      this.bumpScroll()
    },
    bumpScroll() {
      // 简单触发 scroll-view 滚动到底部（uni-app 常用技巧）
      this.scrollTop = 999999
    },
    async send() {
      const text = (this.draft || '').trim()
      if (!text || this.sending) return

      this.messages.push({ role: 'user', content: text })
      this.draft = ''
      this.sending = true
      this.bumpScroll()

      try {
        // DeepSeek 需要多轮对话时，把历史 messages 全量带上
        // 这里统一转成后端可接受的 role：user / assistant / system
        const history = this.messages
          .filter(m => m && (m.content || '').trim())
          .map(m => ({
            role: m.role === 'ai' ? 'assistant' : m.role,
            content: m.content,
          }))

        const res = await aiChat({
          messages: history,
          conversationId: this.conversationId,
        })

        // 兼容多种返回格式：
        // - { reply, conversation_id }
        // - { message, conversation_id }
        // - 直接字符串
        const reply =
          (res && (res.reply || res.message || res.answer || res.data?.reply || res.data?.message)) ??
          (typeof res === 'string' ? res : '')
        const cid = res && (res.conversation_id || res.conversationId || res.data?.conversation_id)

        if (cid) this.conversationId = cid
        this.messages.push({ role: 'ai', content: reply || '（无返回内容）' })
      } catch (e) {
        const msg =
          (e && (e.data?.detail || e.data?.message || e.errMsg || e.message)) ||
          '请求失败'
        this.messages.push({ role: 'ai', content: `接口错误：${msg}` })
      } finally {
        this.sending = false
        this.bumpScroll()
      }
    },
  },
}
</script>

