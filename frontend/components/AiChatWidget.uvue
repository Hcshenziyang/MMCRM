  border-radius: 14px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.ai-header {
  height: 54px;
  background: #fff0e2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  box-sizing: border-box;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.ai-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
}

.ai-header-actions {
  display: flex;
  flex-direction: row;
  gap: 10px;
}

.ai-mini-btn {
  background: #fea17a;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 12px;
  margin: 0;
}
.ai-mini-btn::after {
  border: none;
}

.ai-body {
  flex: 1;
  padding: 12px;
  box-sizing: border-box;
}

.ai-empty {
  padding: 12px;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 10px;
  border: 1px dashed rgba(0, 0, 0, 0.12);
}
.ai-empty-text {
  color: #555;
  font-size: 13px;
  line-height: 1.7;
}

.ai-msg-row {
  display: flex;
  margin-top: 10px;
}
.ai-msg-row.is-user {
  justify-content: flex-end;
}
.ai-msg-row.is-ai {
  justify-content: flex-start;
}

.ai-bubble {
  max-width: 82%;
  padding: 10px 12px;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}
.ai-msg-row.is-user .ai-bubble {
  background: #ffe1d2;
}

.ai-msg-text {
  color: #333;
  font-size: 13px;
  line-height: 1.7;
}

.ai-footer {
  padding: 10px;
  background: #fff;
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: row;
  gap: 10px;
  align-items: center;
  box-sizing: border-box;
}

.ai-input {
  flex: 1;
  height: 36px;
  border: 1px solid #e8e8e8;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 13px;
  box-sizing: border-box;
  background: #fffaf6;
}

.ai-send {
  background: #ff8c5a;
